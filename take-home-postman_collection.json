		{
			"name": "Lead Transitions",
			"description": "Pipeline: NEW → CONTACTED → VISITED → BOOKED\nLOST can be set from any status except BOOKED.\nBOOKED and LOST are terminal — no further transitions.",
			"item": [
				{
					"name": "✅ Valid: NEW → CONTACTED (Lead 1)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Transition successful', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().status).to.eql('CONTACTED');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"CONTACTED\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/leads/1/transition",
							"host": ["{{baseUrl}}"],
							"path": ["leads", "1", "transition"]
						},
						"description": "Lead 1 is seeded as NEW. Should transition to CONTACTED."
					}
				},
				{
					"name": "✅ Valid: CONTACTED → VISITED (Lead 1)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Transition successful', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().status).to.eql('VISITED');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"VISITED\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/leads/1/transition",
							"host": ["{{baseUrl}}"],
							"path": ["leads", "1", "transition"]
						},
						"description": "After previous test, Lead 1 is CONTACTED. Should transition to VISITED."
					}
				},
				{
					"name": "✅ Valid: VISITED → BOOKED (Lead 1) — auto-books property",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Transition to BOOKED successful', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().status).to.eql('BOOKED');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"BOOKED\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/leads/1/transition",
							"host": ["{{baseUrl}}"],
							"path": ["leads", "1", "transition"]
						},
						"description": "After previous test, Lead 1 is VISITED. Should transition to BOOKED.\nProperty 1's status should also auto-update to BOOKED."
					}
				},
				{
					"name": "🔍 Verify: Property 1 is now BOOKED",
					"event": [
						{
							"listen": "test",
							"script": {
