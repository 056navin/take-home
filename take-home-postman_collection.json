									"    pm.expect(jsonData.status).to.eql('NEW');",
									"    pm.collectionVariables.set('newLeadId', jsonData.id);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
