							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"buyerName\": \"Test Buyer\",\n    \"phone\": \"+911234567890\",\n    \"email\": \"testbuyer@email.com\",\n    \"propertyId\": 2,\n    \"priority\": \"HOT\",\n    \"notes\": \"Interested in sea-view apartment\"\n}"
